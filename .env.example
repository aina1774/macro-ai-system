# ============================================================
# AI MACRO INTELLIGENCE SYSTEM — Variables d'environnement
# ============================================================
# Copie ce fichier en ".env" et remplis tes vraies clés.
# Ne commit JAMAIS le fichier .env dans Git.

# ─── APIs Gratuites ─────────────────────────────────────────
# FRED (Federal Reserve) : https://fred.stlouisfed.org/docs/api/fred/
FRED_API_KEY=your_fred_api_key_here

# NewsAPI : https://newsapi.org (500 req/jour gratuit)
NEWSAPI_KEY=your_newsapi_key_here

# Finnhub : https://finnhub.io (60 req/min gratuit)
FINNHUB_KEY=your_finnhub_key_here

# Alpha Vantage : https://www.alphavantage.co (25 req/jour gratuit)
ALPHAVANTAGE_KEY=your_alphavantage_key_here

# ─── Anthropic (Claude) ─────────────────────────────────────
# https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ─── PostgreSQL (Phase 2+, optionnel) ───────────────────────
PG_HOST=localhost
PG_PORT=5432
PG_NAME=macro_ai
PG_USER=postgres
PG_PASSWORD=your_postgres_password
